# =============================================================================
# DATACENDIA ALL-IN-ONE — Railway / Demo Deployment
# Single container: Express serves API + frontend static files.
# Uses Railway-managed PostgreSQL and Redis (no embedded databases).
#
# Build:   docker build -f Dockerfile.allinone -t datacendia:railway .
# Run:     docker run -p 3001:3001 -e DATABASE_URL=... datacendia:railway
# =============================================================================

# Cache-bust: bump this value to force Railway to rebuild all layers
ARG CACHEBUST=2

# ---------------------------------------------------------------------------
# Stage 1: Build frontend (Vite)
# Strip workspaces field so npm ci only installs frontend deps (avoids OOM)
# ---------------------------------------------------------------------------
FROM node:20-alpine AS frontend-builder

WORKDIR /app

COPY package*.json ./

# Remove workspaces to avoid pulling heavy backend deps into this stage
# Then use npm install (not npm ci) since the lockfile was generated with workspaces
RUN node -e "\
  const p = JSON.parse(require('fs').readFileSync('package.json','utf8')); \
  delete p.workspaces; \
  require('fs').writeFileSync('package.json', JSON.stringify(p, null, 2));"

RUN npm install --no-audit --no-fund

# Copy frontend source files
COPY index.html ./
COPY vite.config.ts tsconfig.json tsconfig.node.json ./
COPY tailwind.config.js ./
COPY src ./src
COPY components ./components
COPY lib ./lib

RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Install backend dependencies
# Uses Debian Bookworm (glibc + OpenSSL 3.x) for Prisma engine compatibility
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim AS backend-deps

# Native build tools for better-sqlite3 and other native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/package*.json ./
COPY backend/prisma ./prisma/

RUN npm ci
RUN npx prisma generate

COPY backend/src ./src
COPY backend/tsconfig*.json ./

# ---------------------------------------------------------------------------
# Stage 3: Production runtime
# Uses Debian Bookworm (glibc + OpenSSL 3.x) for Prisma engine compatibility
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init wget openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1001 datacendia && \
    useradd -u 1001 -g datacendia -m datacendia

WORKDIR /app

# Copy backend with node_modules
COPY --from=backend-deps /app/node_modules ./backend/node_modules
COPY --from=backend-deps /app/src ./backend/src
COPY --from=backend-deps /app/prisma ./backend/prisma
COPY --from=backend-deps /app/package.json ./backend/

# Copy built frontend → served as static files by Express
COPY --from=frontend-builder /app/dist ./dist

# Copy entrypoint scripts
COPY backend/docker-entrypoint.sh ./backend/
COPY backend/docker-entrypoint.demo.sh ./backend/
COPY backend/docker-entrypoint.railway.sh ./backend/
RUN chmod +x ./backend/docker-entrypoint.sh \
    ./backend/docker-entrypoint.demo.sh \
    ./backend/docker-entrypoint.railway.sh 2>/dev/null || true

# Set ownership
RUN chown -R datacendia:datacendia /app

USER datacendia

# Railway injects PORT env var; default to 3001
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3001}/health || exit 1

WORKDIR /app/backend

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "--import", "tsx", "src/index.ts"]
