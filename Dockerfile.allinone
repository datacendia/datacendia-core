# =============================================================================
# DATACENDIA ALL-IN-ONE — Railway / Demo Deployment
# Single container: Express serves API + frontend static files.
# Uses Railway-managed PostgreSQL and Redis (no embedded databases).
#
# Build:   docker build -f Dockerfile.allinone -t datacendia:railway .
# Run:     docker run -p 3001:3001 -e DATABASE_URL=... datacendia:railway
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Install dependencies and build frontend
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

# Native build tools needed by better-sqlite3 and other native modules
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy workspace root + backend package manifests so npm can resolve workspaces
COPY package*.json ./
COPY backend/package*.json ./backend/

# Copy Prisma schema (needed by postinstall → prisma generate)
COPY backend/prisma ./backend/prisma/

# Install ALL dependencies (frontend + backend via workspaces)
RUN npm ci

# Copy full source
COPY . .

# Build frontend (vite build → dist/)
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Production runtime
# ---------------------------------------------------------------------------
FROM node:20-alpine AS production

RUN apk add --no-cache dumb-init wget

# Create non-root user
RUN addgroup -g 1001 -S datacendia && \
    adduser -S datacendia -u 1001

WORKDIR /app

# Copy root workspace structure (needed for hoisted node_modules resolution)
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules

# Copy backend source + deps + Prisma client
COPY --from=builder /app/backend/node_modules ./backend/node_modules
COPY --from=builder /app/backend/src ./backend/src
COPY --from=builder /app/backend/prisma ./backend/prisma
COPY --from=builder /app/backend/package.json ./backend/

# Copy built frontend → served as static files by Express
COPY --from=builder /app/dist ./dist

# Copy entrypoint scripts
COPY backend/docker-entrypoint.sh ./backend/
COPY backend/docker-entrypoint.demo.sh ./backend/
COPY backend/docker-entrypoint.railway.sh ./backend/
RUN chmod +x ./backend/docker-entrypoint.sh \
    ./backend/docker-entrypoint.demo.sh \
    ./backend/docker-entrypoint.railway.sh 2>/dev/null || true

# Set ownership
RUN chown -R datacendia:datacendia /app

USER datacendia

# Railway injects PORT env var; default to 3001
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3001}/health || exit 1

WORKDIR /app/backend

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "--import", "tsx", "src/index.ts"]
