# ============================================
# DATACENDIA PLATFORM - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# Default values match docker-compose.unified.yml

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
DEPLOYMENT_MODE=standalone
REQUIRE_AUTH=true
SESSION_SECRET=CHANGE_ME_GENERATE_A_SECURE_SECRET

# ============================================
# DATABASE - PostgreSQL
# ============================================
POSTGRES_USER=datacendia
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
POSTGRES_DB=datacendia
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public

# ============================================
# CACHE - Redis
# ============================================
REDIS_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6380
# REDIS_HOST=localhost
# REDIS_PORT=6380

# ============================================
# GRAPH DATABASE - Neo4j
# ============================================
NEO4J_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# ============================================
# AUTHENTICATION - JWT
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_64_CHAR_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_SECURE_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# ENCRYPTION & SIGNING
# ============================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY
# CENDIA_MASTER_SEED=             # Master seed for key derivation
# CENDIA_ED25519_PRIVATE_KEY=     # Ed25519 signing key (base64)
# CENDIA_DILITHIUM_PRIVATE_KEY=   # Post-quantum signing key (base64)

# ============================================
# AI / LLM
# ============================================
# Ollama (Local) - default
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL_FAST=               # Fast model for quick tasks
# OLLAMA_MODEL_FLAGSHIP=           # Best model for complex tasks

# OpenAI (Cloud) - optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_BASE_URL=                 # Custom endpoint (Azure, etc.)
# OPENAI_API_BASE=                 # Legacy: use OPENAI_BASE_URL instead
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Inference routing
# INFERENCE_PROVIDER=ollama        # ollama | openai | nvidia
# INFERENCE_FAILOVER=true          # Auto-failover between providers

# NVIDIA NIM (Optional)
# NIM_BASE_URL=
# NIM_MODEL_NAME=

# NVIDIA Triton (Optional)
# TRITON_BASE_URL=
# TRITON_MODEL_NAME=

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=https://app.datacendia.com
# CORS_ORIGINS=                    # Comma-separated list of allowed origins
TRUSTED_PROXIES=nginx

# ============================================
# GATEWAY (AI Governance Proxy)
# ============================================
# GATEWAY_PROXY_HOST=0.0.0.0
# GATEWAY_PROXY_PORT=8443
# GATEWAY_SIGNING_KEY=
# GATEWAY_BLOCK_UNGOVERNED=false
# GATEWAY_HTTPS_INSPECTION=false
# GATEWAY_CA_CERT_PATH=
# GATEWAY_CA_KEY_PATH=
# GATEWAY_CUSTOM_AI_DOMAINS=       # Comma-separated custom AI endpoint domains
# GATEWAY_API_URL=

# ============================================
# EMAIL (Choose one provider)
# ============================================
# SendGrid
SENDGRID_API_KEY=
EMAIL_FROM=noreply@datacendia.com

# Or SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@datacendia.com

# ============================================
# BILLING - Stripe
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# IDENTITY PROVIDER - Keycloak (Optional)
# ============================================
# KEYCLOAK_URL=
# KEYCLOAK_REALM=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# ============================================
# HEALTHCARE / FHIR (Vertical)
# ============================================
# FHIR_BASE_URL=
# FHIR_CLIENT_ID=
# FHIR_CLIENT_SECRET=
# FHIR_TOKEN_URL=
# FHIR_EHR_VENDOR=epic
# FHIR_SCOPES=patient/*.read

# ============================================
# ANALYTICS - ClickHouse (Optional)
# ============================================
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DB=datacendia

# ============================================
# ANALYTICS - Druid (Optional)
# ============================================
# DRUID_BROKER_URL=http://localhost:8082
# DRUID_COORDINATOR_URL=http://localhost:8081
# DRUID_ROUTER_URL=http://localhost:8888

# ============================================
# OBJECT STORAGE - MinIO (Optional)
# ============================================
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_USE_SSL=false

# ============================================
# EVIDENCE & COMPLIANCE
# ============================================
# EVIDENCE_EXPORT_PATH=./exports
# EVIDENCE_LEDGER_PATH=./ledger
# BACKUP_ENABLED=false

# ============================================
# INTEGRATIONS (Optional)
# ============================================
# SALESFORCE_CLIENT_ID=
# HUBSPOT_CLIENT_ID=
# SLACK_CLIENT_ID=
# N8N_URL=
# N8N_API_KEY=

# ============================================
# EXTERNAL DATA APIs (Optional)
# ============================================
# FRED_API_KEY=                    # Federal Reserve Economic Data
# OPENSTATES_API_KEY=              # State legislature data

# ============================================
# FEATURE FLAGS
# ============================================
# UNLEASH_URL=
# UNLEASH_API_TOKEN=
ENABLE_DEMO_MODE=false
ENABLE_OLLAMA=true
ENABLE_OPENAI=false
ENABLE_BILLING=false
# TRACING_ENABLED=false

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=
DATADOG_API_KEY=
# PROMETHEUS_URL=http://localhost:9090

# ============================================
# FRONTEND BUILD ARGS
# ============================================
VITE_API_URL=https://api.datacendia.com/api/v1
VITE_WS_URL=wss://api.datacendia.com
VITE_APP_NAME=Datacendia
VITE_APP_VERSION=1.0.0
